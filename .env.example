# Optional. Without this, SkillGraph falls back to its built-in deterministic
# skill-matching engine (no external calls, no cost). Add a free Gemini key
# from https://aistudio.google.com/apikey to unlock LLM-assisted extraction
# and richer roadmap writeups.
GEMINI_API_KEY=

# Optional. Without this, GitHub lookups are rate-limited to 60 requests/hour
# per IP. Add a personal access token (no scopes needed, public data only)
# from https://github.com/settings/tokens to raise that to 5000/hour.
GITHUB_TOKEN=
